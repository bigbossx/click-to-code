{
  "name": "click-to-code",
  "version": "1.0.0",
  "packageManager": "pnpm@12.3.4",
  "description": "Option+Click a React component to open its source in your editor",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "examples/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "examples:build": "pnpm build && pnpm --filter @click-to-code/example-vite-react build && pnpm --filter @click-to-code/example-webpack-react build && pnpm --filter @click-to-code/example-next build",
    "examples:next": "pnpm --filter @click-to-code/example-next dev",
    "examples:vite": "pnpm --filter @click-to-code/example-vite-react dev",
    "examples:webpack": "pnpm --filter @click-to-code/example-webpack-react dev",
    "test": "vitest run",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigbossx/code-to-code.git"
  },
  "bugs": {
    "url": "https://github.com/bigbossx/code-to-code/issues"
  },
  "homepage": "https://github.com/bigbossx/code-to-code#readme",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
